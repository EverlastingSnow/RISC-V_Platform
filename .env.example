# RISC-V Platform Environment Configuration
# Copy this file to .env and modify values as needed

# Toolchain path (if not in default location)
# RISCV_TOOLCHAIN_PATH=C:\path\to\riscv-toolchain\bin

# Service ports
# API_SERVER_PORT=8080
# WEBSOCKET_PORT=8081
# STATS_PORT=8082
# COMPILE_SERVER_PORT=8083

# Simulator executable path (if not in default build directory)
# SIM_SERVER_PATH=C:\path\to\riscv_sim_server.exe

# Teaching tests directory
# RISCV_TEACHING_DIR=C:\path\to\teaching
